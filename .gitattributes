* text=auto

# Source and project text files
*.bd text eol=lf
*.ipynb text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sv text eol=lf
*.svh text eol=lf
*.tcl text eol=lf
*.txt text eol=lf
*.v text eol=lf
*.vh text eol=lf
*.xdc text eol=lf
*.xci text eol=lf
*.xpr text eol=lf

# TICS Pro exports are frozen byte-for-byte and use CRLF.  Preserve their
# original bytes so the documented LMK profile SHA256 remains reproducible.
reports/arch/*.tcs binary
reports/arch/lmk04828*_registers.txt binary

# Binary documentation/assets
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
