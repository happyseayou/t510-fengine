[Unit]
Description=T510 Stage 34d shared-SSA Allan and complex cross-correlation campaign
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/astrolab/demo-ant
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/astrolab/demo-ant/scripts/stage-34/t510_allan_interferometry.py --phase shared --shared-ssa-confirmed
Restart=no
TimeoutStartSec=infinity
StandardOutput=append:/home/astrolab/demo-ant/build/receiver/latest/evidence/allan_interferometry/shared_long_task.log
StandardError=append:/home/astrolab/demo-ant/build/receiver/latest/evidence/allan_interferometry/shared_long_task.log

[Install]
WantedBy=default.target
