{
  "openapi": "3.1.0",
  "info": {
    "title": "T510 Stateless Board Agent",
    "version": "0.3.7",
    "description": "Current F-engine control for the catalog-selected verified CORE_VERSION: fixed 4096-channel 8-tap PFB, full TIME/SPEC UDP, and explicit external_10mhz or onboard_tcxo operation. ADC/DAC analog sampling is 3.84 GS/s with 12x decimation/interpolation; sample_rate_msps is the 160/320 MS/s complex-sample-rate tier. security_mode=none; laboratory LAN only."
  },
  "servers": [{"url": "http://192.168.100.117:8010"}],
  "paths": {
    "/": {"get": {"summary": "Redirect to help", "responses": {"302": {"description": "Found"}}}},
    "/api/help": {"get": {"summary": "Self-contained API help", "responses": {"200": {"description": "HTML help"}}}},
    "/api/openapi.json": {"get": {"summary": "OpenAPI 3.1 document", "responses": {"200": {"description": "OpenAPI JSON"}}}},
    "/health/live": {"get": {"summary": "Process liveness", "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/health/ready": {"get": {"summary": "Local-file readiness; never accesses FPGA", "responses": {"200": {"$ref": "#/components/responses/Success"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/info": {"get": {"summary": "Device and management-network information", "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/v2/capabilities": {"get": {"summary": "Supported and unsupported capabilities", "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/v2/bitstreams": {"get": {"summary": "Named bitstream catalog", "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/v2/status": {"get": {"summary": "One hardware register snapshot", "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration": {"get": {"summary": "Read all-eight ADC CalFreeze and OCB1/OCB2/GCB/TSCB coefficients", "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/monitor": {"get": {"summary": "Read the resident one-second calibration observation without starting a hardware helper", "responses": {"200": {"$ref": "#/components/responses/Success"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/telemetry/power-thermal": {"get": {"summary": "Read bounded resident 1-second AMS, RFDC tile, stream and calibration telemetry after since_seq", "responses": {"200": {"$ref": "#/components/responses/Success"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/diagnostics/output-load": {"get": {"summary": "Read output-load diagnostic state", "responses": {"200": {"$ref": "#/components/responses/Success"}}}, "post": {"summary": "Switch stopped 160 MS/s hardware between SPEC_ONLY and TIME_SPEC without MTS/NCO/PFB changes", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OutputLoadRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/diagnostics/output-load/restore": {"post": {"summary": "Restore the output mode preceding an output-load transaction", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticMutationRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/power": {"get": {"summary": "Read normalized XRFdc_GetIPStatus and DAC-tile diagnostic state", "responses": {"200": {"$ref": "#/components/responses/Success"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/power/dac-shutdown": {"post": {"summary": "Shut down all four DAC tiles while preserving all ADC tiles", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticMutationRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/power/restore": {"post": {"summary": "Restore all RFDC tiles using full production CONFIGURE/MTS", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticMutationRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/ocb1": {"get": {"summary": "Read OCB1 override state, coefficients, DFT, transaction and hashes", "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/ocb1/snapshot-override": {"post": {"summary": "Atomically snapshot and override all eight OCB1 banks", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ocb1Request"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/ocb1/release": {"post": {"summary": "Release all eight OCB1 overrides and require fresh CONFIGURE/MTS", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ocb1Request"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/freeze": {"post": {"summary": "Atomically freeze all eight ADC calibration loops", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CalibrationRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/unfreeze": {"post": {"summary": "Atomically unfreeze all eight ADC calibration loops", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CalibrationRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/preview": {"post": {"summary": "Capture all-eight RFDC preview while science UDP remains stopped", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CalibrationRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/rfdc/calibration/train-freeze": {"post": {"summary": "Validate the fixed training tone, wait for GCB/TSCB convergence, freeze all ADCs, and mute DAC", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CalibrationRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/clock/diagnostic": {"get": {"summary": "Read the active LMK diagnostic profile, SYSREF request GPIO, PLL locks, MTS result, and transaction", "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/clock/diagnostic/prepare": {"post": {"summary": "Atomically prepare a frozen clock diagnostic clock profile and issue a one-use transaction", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClockDiagnosticPrepareRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/clock/diagnostic/restore": {"post": {"summary": "Restore the clock reference selected by the last production CONFIGURE, then reset RFDC and run MTS", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClockDiagnosticRestoreRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/configure": {"post": {"summary": "Load and configure hardware, leaving streaming stopped", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfigureRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/start": {"post": {"summary": "Immediate start", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpectedBoardRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/sync/status": {"get": {"summary": "Scheduled-sync status and commit telemetry", "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/sync/prepare": {"post": {"summary": "Prepare an immutable scheduled-sync generation bundle", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScheduledSyncPrepareRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/sync/arm": {"post": {"summary": "Arm the previously prepared generation", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpectedBoardRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/sync/abort": {"post": {"summary": "Abort a generation and flush the dual-clock data path", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpectedBoardRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/stop": {"post": {"summary": "Safe stop, full pipeline flush, and idle verification", "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/reset": {"post": {"summary": "Safe stop and full pipeline flush, then reset", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpectedBoardRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/v2/dac": {"put": {"summary": "Atomic eight-channel DAC update", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DacRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "responses": {
      "Success": {"description": "Successful response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuccessEnvelope"}}}},
      "Error": {"description": "Stable error envelope", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    },
    "schemas": {
      "SuccessEnvelope": {"type": "object", "required": ["request_id", "result"], "properties": {"request_id": {"type": "string"}, "result": {}}},
      "ErrorEnvelope": {"type": "object", "required": ["request_id", "code", "message"], "properties": {"request_id": {"type": "string"}, "code": {"type": "string"}, "message": {"type": "string"}, "details": {}}},
      "ExpectedBoardRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "ocb1_transaction_id": {"type": "string"}, "clock_transaction_id": {"type": "string"}, "output_load_transaction_id": {"type": "string"}, "rfdc_power_transaction_id": {"type": "string"}}},
      "DiagnosticMutationRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id", "receiver_stream_accepting"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "receiver_stream_accepting": {"type": "boolean", "const": false}}},
      "OutputLoadRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id", "receiver_stream_accepting", "mode"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "receiver_stream_accepting": {"type": "boolean", "const": false}, "mode": {"type": "string", "enum": ["spec_only", "time_spec"]}}},
      "Ocb1Request": {"type": "object", "additionalProperties": false, "required": ["expected_board_id", "receiver_stream_accepting"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "receiver_stream_accepting": {"type": "boolean", "const": false}, "ocb1_transaction_id": {"type": "string"}}},
      "CalibrationRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "training_dac_active": {"type": "boolean", "default": false, "description": "Declares the controlled center+60 MHz all-eight training transaction; successful freeze mutes DAC before returning."}, "training_amplitude_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "description": "Required when training_dac_active=true; calibration qualification selects the formal value using an all-eight 25/50/75/100 percent preflight."}}},
      "ClockDiagnosticPrepareRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id", "profile_id", "sample_rate_msps", "center_mhz", "receiver_stream_accepting"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "profile_id": {"type": "string", "description": "Frozen clock diagnostic diagnostic profile: production continuous, external/TCXO request, or a TICS-frozen 10/5 MHz SDCLKout3 phase profile."}, "sample_rate_msps": {"type": "integer", "enum": [160, 320]}, "center_mhz": {"type": "number", "minimum": 160, "maximum": 1760}, "receiver_stream_accepting": {"type": "boolean", "const": false}, "mts_target_mode": {"type": "string", "enum": ["catalog", "discovery", "fixed"], "default": "catalog"}, "mts_adc_target_latency": {"type": "integer", "minimum": 0}, "mts_dac_target_latency": {"type": "integer", "minimum": 0}, "verify_sysref_negative_control": {"type": "boolean", "default": false, "description": "External CLKin2 request profiles only, including frozen 10/5 MHz phase profiles: prove a bounded MTS attempt cannot complete while SYSREF_REQ is held low, then reset and run normal MTS."}}},
      "ClockDiagnosticRestoreRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id", "receiver_stream_accepting"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "receiver_stream_accepting": {"type": "boolean", "const": false}}},
      "ScheduledSyncPrepareRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id", "generation", "target_pps_count", "epoch_tai_seconds", "signal_chain_tag", "mts_result_id"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "generation": {"type": "integer", "minimum": 1}, "target_pps_count": {"type": "integer", "minimum": 1}, "epoch_tai_seconds": {"type": "integer", "minimum": 1}, "first_sample0": {"type": "integer", "minimum": 4, "multipleOf": 4, "description": "Optional. Omit to derive a reachable value from the active sample-rate and half-band path."}, "observation_tag": {"type": "integer", "minimum": 0}, "signal_chain_tag": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "schedule_tag": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "mts_result_id": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "ocb1_transaction_id": {"type": "string"}, "clock_transaction_id": {"type": "string"}, "output_load_transaction_id": {"type": "string"}, "rfdc_power_transaction_id": {"type": "string"}}},
      "Profile": {"oneOf": [{"title": "160 MS/s profile", "type": "object", "additionalProperties": false, "required": ["sample_rate_msps", "mode", "center_mhz"], "properties": {"sample_rate_msps": {"type": "integer", "const": 160, "description": "Complex sample-rate tier in MS/s."}, "mode": {"type": "string", "enum": ["time_only", "spec_only", "time_spec"]}, "center_mhz": {"type": "number", "minimum": 80, "maximum": 1840, "description": "Complete +/-80 MHz complex band remains inside the first Nyquist zone."}}}, {"title": "320 MS/s profile", "type": "object", "additionalProperties": false, "required": ["sample_rate_msps", "mode", "center_mhz"], "properties": {"sample_rate_msps": {"type": "integer", "const": 320, "description": "Complex sample-rate tier in MS/s."}, "mode": {"type": "string", "enum": ["time_only", "spec_only"], "description": "time_spec is unsupported at 320 MS/s."}, "center_mhz": {"type": "number", "minimum": 160, "maximum": 1760, "description": "Complete +/-160 MHz complex band remains inside the first Nyquist zone."}}}]},
      "Source": {"type": "object", "additionalProperties": false, "required": ["ip", "mac"], "properties": {"ip": {"type": "string", "format": "ipv4"}, "mac": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"}}},
      "Endpoint": {"type": "object", "additionalProperties": false, "required": ["endpoint_id", "stream", "enabled", "destination_ip", "destination_mac", "source_port", "destination_port"], "properties": {"endpoint_id": {"type": "integer", "minimum": 0, "maximum": 23}, "stream": {"type": "string", "enum": ["TIME", "SPEC"]}, "enabled": {"type": "boolean"}, "destination_ip": {"type": "string", "format": "ipv4"}, "destination_mac": {"type": "string"}, "source_port": {"type": "integer", "minimum": 1, "maximum": 65535}, "destination_port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
      "ConfigureRequest": {"type": "object", "additionalProperties": false, "required": ["bitstream_id", "board_id", "profile", "source", "endpoints"], "properties": {"bitstream_id": {"type": "string"}, "board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "clock_reference": {"type": "string", "enum": ["external_10mhz", "onboard_tcxo"], "default": "external_10mhz", "description": "Set this explicitly. onboard_tcxo uses LMK CLKin0, request-mode SYSREF only during MTS, free-run sample time, and needs no external 10 MHz or PPS."}, "update_mode": {"type": "string", "enum": ["full", "clock_preserving"], "default": "full", "description": "clock_preserving performs a non-hitless, no-power-cycle PL update only after exact live clock identity and dual-PLL checks; it never rewrites the LMK profile."}, "receiver_stream_accepting": {"type": "boolean", "description": "Must be explicitly false for update_mode=clock_preserving."}, "profile": {"$ref": "#/components/schemas/Profile"}, "source": {"$ref": "#/components/schemas/Source"}, "endpoints": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/components/schemas/Endpoint"}}}},
      "DacChannel": {"type": "object", "additionalProperties": false, "required": ["channel", "enabled", "rf_frequency_mhz", "amplitude_percent", "phase_deg"], "properties": {"channel": {"type": "integer", "minimum": 0, "maximum": 7}, "enabled": {"type": "boolean"}, "rf_frequency_mhz": {"type": "number", "minimum": 1, "exclusiveMaximum": 1920, "description": "Must also lie within center +/-80 MHz for an active 160 MS/s profile or center +/-160 MHz for 320 MS/s."}, "amplitude_percent": {"type": "number", "minimum": 0, "maximum": 100}, "phase_deg": {"type": "number", "minimum": -180, "maximum": 180}}},
      "DacRequest": {"type": "object", "additionalProperties": false, "required": ["expected_board_id", "center_mhz", "channels"], "properties": {"expected_board_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "center_mhz": {"type": "number", "minimum": 80, "maximum": 1840, "description": "Must exactly match all live DAC RFDC mixer centers; mismatch returns HTTP 409."}, "channels": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/components/schemas/DacChannel"}}}}
    }
  }
}
