[Unit]
Description=T510 Stage 34c-3 power and thermal causality campaign
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/astrolab/demo-ant
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/astrolab/demo-ant/scripts/t510_power_thermal_causality.py --ssa-confirmed --resume-natural --dac-intervention-unqualified-evidence /home/astrolab/demo-ant/build/board/latest/evidence/power_thermal_causality/dac_intervention_qualification.json
Restart=no
TimeoutStartSec=infinity
StandardOutput=append:/home/astrolab/demo-ant/build/receiver/latest/evidence/power_thermal_causality/long_task.log
StandardError=append:/home/astrolab/demo-ant/build/receiver/latest/evidence/power_thermal_causality/long_task.log

[Install]
WantedBy=default.target
