# OS/editor noise
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Python/Jupyter caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Vivado/XSim generated state
/.Xil/
/.xsim_batch/
/.xsim_xfft_wrapper/
/.vmcp/
/demo-ant.cache/
/demo-ant.gen/
/demo-ant.hw/
/demo-ant.ip_user_files/
