# Vivado source mirror: keep only the two current reproducible IP configs.
/demo-ant.srcs/*
!/demo-ant.srcs/sources_1/
/demo-ant.srcs/sources_1/*
!/demo-ant.srcs/sources_1/ip/
/demo-ant.srcs/sources_1/ip/*
!/demo-ant.srcs/sources_1/ip/t510_cmac_usplus_0/
/demo-ant.srcs/sources_1/ip/t510_cmac_usplus_0/*
!/demo-ant.srcs/sources_1/ip/t510_cmac_usplus_0/t510_cmac_usplus_0.xci
!/demo-ant.srcs/sources_1/ip/t510_fengine_xfft_4096_lane/
/demo-ant.srcs/sources_1/ip/t510_fengine_xfft_4096_lane/*
!/demo-ant.srcs/sources_1/ip/t510_fengine_xfft_4096_lane/t510_fengine_xfft_4096_lane.xci

# The repository-level overlay is a generated link to the accepted release.
/overlay/

# Build/runtime artifacts
/build/
rust/**/target/
*.bit
*.dcp
*.jou
*.log
*.rpt
*.rpx
*.str
*.wdb
*.wcfg
hs_err_pid*.log
/tight_setup_hold_pins.txt
/xvlog.pb

# Top-level hardware run captures
/stage*.json
/stage*_stderr.txt
/stage*_stdout.txt

# Large runtime report captures; keep reports/stages and reports/arch docs.
/reports/*.json
/reports/*.log
/reports/*.stdout.json
/reports/*.stdout.log
/reports/*.stderr.log
/reports/board/
